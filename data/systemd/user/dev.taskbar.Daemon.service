[Unit]
Description=Taskbar tray daemon (StatusNotifierItem host)
Documentation=https://github.com/sequ-r/trayble
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=dev.taskbar.Daemon
ExecStart=@BINDIR@/taskbar-daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
